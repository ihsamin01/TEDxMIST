# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# Supabase → Project Settings → Data API
SUPABASE_URL=https://your-project.supabase.co

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...)
# An older project's service_role key works too.
# Server-side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# The shared password for /admin. Pick something long.
ADMIN_PASSWORD=


# The Gmail account the confirmation emails are sent from.
GMAIL_USER=tedximistuniversity@gmail.com

# NOT the account password. Google Account → Security → App passwords.
# Spaces are stripped, so paste it however Google shows it.
GMAIL_APP_PASSWORD=

# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# Supabase → Project Settings → Data API
SUPABASE_URL=https://your-project.supabase.co

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...)
# An older project's service_role key works here too.
# Server-side only. It bypasses row level security, so it must never be
# prefixed with NEXT_PUBLIC_ or used in a Client Component.
SUPABASE_SECRET_KEY=

# The shared password for /admin. Pick something long.
ADMIN_PASSWORD=


# The Gmail account the confirmation emails are sent from.
GMAIL_USER=tedximistuniversity@gmail.com

# NOT the account password. Google Account → Security → 2-Step Verification
# → App passwords. Google shows it as four blocks of four letters; spaces are
# stripped automatically, so paste it either way.
GMAIL_APP_PASSWORD=
